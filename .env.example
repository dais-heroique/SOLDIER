# Copier en .env et remplir. .env est dans .gitignore — ne jamais le commiter.
# Voir README_RAM_SNIPER.md §2 pour la procédure d'obtention de chaque clé.

# Telegram — @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# https://api.telegram.org/bot<TOKEN>/getUpdates après avoir écrit au bot.
# Pour un groupe à deux : id négatif du type -1001234567890
TELEGRAM_CHAT_ID=

# Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
